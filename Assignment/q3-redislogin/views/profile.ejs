<!DOCTYPE html>
<html>

<head>

    <title>Profile</title>

    <style>

        body {
            font-family: Arial;

            margin: 0;

            background: #f4f4f4;
        }

        .navbar {
            background: #222;

            padding: 15px;
        }

        .navbar a {
            color: white;

            text-decoration: none;

            margin-right: 25px;
        }

        .container {
            width: 700px;

            margin: 50px auto;

            background: white;

            padding: 30px;

            border-radius: 10px;

            box-shadow: 0 0 10px #ccc;
        }

        table {
            width: 100%;

            border-collapse: collapse;

            margin-top: 20px;
        }

        th,
        td {
            border: 1px solid #ccc;

            padding: 12px;

            text-align: left;
        }

        th {
            background: #eee;
        }

    </style>

</head>

<body>

<div class="navbar">

    <a href="/dashboard">
        Dashboard
    </a>

    <a href="/profile">
        Profile
    </a>

    <a href="/logout">
        Logout
    </a>

</div>

<div class="container">

    <h1>User Profile</h1>

    <table>

        <tr>
            <th>Username</th>

            <td>
                <%= user.username %>
            </td>
        </tr>

        <tr>
            <th>Email</th>

            <td>
                <%= user.email %>
            </td>
        </tr>

        <tr>
            <th>Session Store</th>

            <td>
                Redis
            </td>
        </tr>

        <tr>
            <th>Status</th>

            <td>
                Logged In
            </td>
        </tr>

    </table>

</div>

</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Employees</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <nav class="navbar">

        <div class="brand">
            ERP ADMIN PANEL
        </div>

        <div class="nav-links">

            <a href="/dashboard">
                Dashboard
            </a>

            <a href="/employees">
                Employees
            </a>

            <a href="/employees/add">
                Add Employee
            </a>

            <a href="/logout">
                Logout
            </a>

        </div>

    </nav>


    <main class="container">

        <div class="page-header">

            <h1>
                Employee Management
            </h1>

            <a
                href="/employees/add"
                class="btn"
            >
                + Add Employee
            </a>

        </div>


        <% if (message) { %>

            <div class="success">
                <%= message %>
            </div>

        <% } %>


        <% if (error) { %>

            <div class="error">
                <%= error %>
            </div>

        <% } %>


        <div class="table-container">

            <table>

                <thead>

                    <tr>

                        <th>Emp ID</th>

                        <th>Name</th>

                        <th>Email</th>

                        <th>Department</th>

                        <th>Designation</th>

                        <th>Basic Salary</th>

                        <th>HRA</th>

                        <th>DA</th>

                        <th>Gross Salary</th>

                        <th>PF</th>

                        <th>Tax</th>

                        <th>Net Salary</th>

                        <th>Actions</th>

                    </tr>

                </thead>


                <tbody>

                    <% if (employees.length === 0) { %>

                        <tr>

                            <td
                                colspan="13"
                                class="no-data"
                            >
                                No employees found.
                            </td>

                        </tr>

                    <% } %>


                    <% employees.forEach(employee => { %>

                        <tr>

                            <td>
                                <strong>
                                    <%= employee.empid %>
                                </strong>
                            </td>

                            <td>
                                <%= employee.name %>
                            </td>

                            <td>
                                <%= employee.email %>
                            </td>

                            <td>
                                <%= employee.department %>
                            </td>

                            <td>
                                <%= employee.designation %>
                            </td>

                            <td>
                                ₹<%= employee.basicSalary.toFixed(2) %>
                            </td>

                            <td>
                                ₹<%= employee.hra.toFixed(2) %>
                            </td>

                            <td>
                                ₹<%= employee.da.toFixed(2) %>
                            </td>

                            <td>
                                ₹<%= employee.grossSalary.toFixed(2) %>
                            </td>

                            <td>
                                ₹<%= employee.pf.toFixed(2) %>
                            </td>

                            <td>
                                ₹<%= employee.tax.toFixed(2) %>
                            </td>

                            <td>
                                <strong>
                                    ₹<%= employee.netSalary.toFixed(2) %>
                                </strong>
                            </td>

                            <td>

                                <a
                                    href="/employees/edit/<%= employee._id %>"
                                    class="edit-btn"
                                >
                                    Edit
                                </a>

                                <form
                                    action="/employees/delete/<%= employee._id %>"
                                    method="POST"
                                    class="delete-form"
                                    onsubmit="return confirm('Are you sure you want to delete this employee?')"
                                >

                                    <button
                                        type="submit"
                                        class="delete-btn"
                                    >
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </main>

</body>

</html>